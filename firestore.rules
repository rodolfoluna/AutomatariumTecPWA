rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura a las colecciones académicas
    // (Grupos, Actividades, Alumnos, Entregas y Configuración)
    // Permite la sincronización en tiempo real entre docentes y alumnos en cualquier navegador/dispositivo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
