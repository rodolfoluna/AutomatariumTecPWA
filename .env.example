# Variables de Entorno de Firebase (Spark Plan Gratuito)
# Obtén estos valores en la Consola de Firebase -> Configuración del Proyecto -> General -> Tus apps (Web)

VITE_FIREBASE_API_KEY=AIzaSyA...
VITE_FIREBASE_AUTH_DOMAIN=automatarium-tec.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=automatarium-tec
VITE_FIREBASE_STORAGE_BUCKET=automatarium-tec.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
