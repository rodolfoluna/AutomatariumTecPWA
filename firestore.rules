rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLA UNIVERSAL PARA SINCRONIZACIÓN COMPLETA DOCENTE - ALUMNO
    // Permite lectura y escritura en todas las colecciones:
    // - groups: Grupos escolares
    // - activities: Actividades y ejercicios
    // - students: Directorio de alumnos y contraseñas
    // - submissions: Entregas y diagramas en tiempo real
    // - teams: Equipos de trabajo colaborativo
    // - invitations: Invitaciones entre compañeros
    // - student_preferences: Modalidad individual vs equipo
    // - settings: Configuración y estado de inicialización
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
